{
  "autocompleteMaxVisible": 3,
  "collapseChangelog": true,
  "compaction": {
    "enabled": true
  },
  "defaultModel": "gpt-5.6-sol",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "high",
  "doubleEscapeAction": "tree",
  "enabledModels": [
    "anthropic/claude-fable-5",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "anthropic/claude-opus-5"
  ],
  "hideThinkingBlock": true,
  "httpIdleTimeoutMs": 90000,
  "images": {
    "blockImages": false
  },
  "lastChangelogVersion": "0.84.4",
  "packages": [
    "npm:@ryan_nookpi/pi-extension-codex-fast-mode",
    "npm:@ryan_nookpi/pi-extension-ask-user-question",
    "npm:@ryan_nookpi/pi-extension-auto-name",
    "npm:@ryan_nookpi/pi-extension-delayed-action",
    "npm:@ryan_nookpi/pi-extension-open-pr",
    "npm:@ryan_nookpi/pi-extension-generative-ui",
    "npm:@ryan_nookpi/pi-extension-cross-agent",
    "npm:@ryan_nookpi/pi-extension-claude-hooks-bridge",
    "npm:@ryan_nookpi/pi-extension-claude-mcp-bridge",
    "npm:@ryan_nookpi/pi-extension-memory-layer",
    "npm:@ryan_nookpi/pi-extension-claude-spinner",
    "npm:@ryan_nookpi/pi-extension-cc-system-prompt",
    "npm:@ryan_nookpi/pi-extension-todo-write-overlay",
    "npm:@ryan_nookpi/pi-extension-diff-review",
    "npm:@ryan_nookpi/pi-extension-subagent",
    "npm:@ryan_nookpi/pi-extension-clipboard",
    "npm:@ryan_nookpi/pi-extension-until"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 15,
    "baseDelayMs": 3000
  },
  "quietStartup": true,
  "subagent": {
    "claudeRuntime": "cli",
    "symbolMap": {
      "!": "challenger",
      "?": "searcher",
      "@": "browser"
    }
  },
  "terminal": {
    "showImages": false
  },
  "theme": "nord",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto"
}