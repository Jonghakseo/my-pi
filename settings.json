{
  "autocompleteMaxVisible": 3,
  "collapseChangelog": true,
  "compaction": {
    "enabled": true
  },
  "defaultModel": "claude-opus-5-5",
  "defaultProvider": "anthropic",
  "defaultThinkingLevel": "medium",
  "doubleEscapeAction": "tree",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "anthropic/claude-opus-5-5",
    "openai-codex/gpt-6.1-sol",
    "anthropic/claude-fable-5-1",
    "anthropic/claude-haiku-5-5"
  ],
  "fullscreenScrollbar": "auto",
  "hideThinkingBlock": true,
  "httpIdleTimeoutMs": 180000,
  "images": {
    "blockImages": false
  },
  "lastChangelogVersion": "1.1.0",
  "packages": [
    "npm:@ryan_nookpi/pi-extension-codex-fast-mode",
    "npm:@ryan_nookpi/pi-extension-ask-user-question",
    "npm:@ryan_nookpi/pi-extension-auto-name",
    "npm:@ryan_nookpi/pi-extension-delayed-action",
    "npm:@ryan_nookpi/pi-extension-open-pr",
    "npm:@ryan_nookpi/pi-extension-cross-agent",
    "npm:@ryan_nookpi/pi-extension-claude-hooks-bridge",
    "npm:@ryan_nookpi/pi-extension-memory-layer",
    "npm:@ryan_nookpi/pi-extension-claude-spinner",
    "npm:@ryan_nookpi/pi-extension-todo-write-overlay",
    "npm:@ryan_nookpi/pi-extension-diff-review",
    "npm:@ryan_nookpi/pi-extension-subagent",
    "npm:@ryan_nookpi/pi-extension-clipboard",
    "npm:@ryan_nookpi/pi-extension-cron",
    "npm:@dev.fast/pi-whiteboard",
    "npm:@ryan_nookpi/pi-extension-vcc-ko",
    "npm:@ryan_nookpi/pi-extension-bash-async",
    "npm:@ryan_nookpi/pi-extension-web-access",
    "npm:@ryan_nookpi/pi-skill-skill-creator",
    "npm:@ryan_nookpi/pi-skill-tmux-terminal",
    "npm:@ryan_nookpi/pi-skill-chrome-cdp",
    "npm:@ryan_nookpi/pi-skill-a4",
    "npm:@ryan_nookpi/pi-skill-excalidraw"
  ],
  "quietStartup": true,
  "retry": {
    "baseDelayMs": 3000,
    "enabled": true,
    "maxRetries": 15
  },
  "subagent": {
    "claudeRuntime": "cli",
    "symbolMap": {
      "!": "challenger",
      "?": "searcher",
      "@": "browser"
    }
  },
  "terminal": {
    "showImages": true
  },
  "theme": "nord",
  "tuiMode": "fullscreen",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "showHardwareCursor": true
}